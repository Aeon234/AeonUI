<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="AeonUISettings_SettingRowTemplate" mixin="AeonUISettings_SettingRowMixin" virtual="true">
		<Size y="36"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Band"/>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="Hover" hidden="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Divider" hidden="true">
					<Size x="1"/>
					<Anchors>
						<Anchor point="TOP"/>
						<Anchor point="BOTTOM"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="First"/>
			<Frame parentKey="Second" hidden="true"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="RefreshHover"/>
			<OnLeave method="RefreshHover"/>
			<OnHide method="RefreshHover"/>
		</Scripts>
	</Frame>
</Ui>
