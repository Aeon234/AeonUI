<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="AeonUISettings_PickerRowTemplate" mixin="AeonUISettings_PickerRowMixin" virtual="true">
		<Size y="50"/>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Band" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
