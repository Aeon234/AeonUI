{
  "$schema": "https://raw.githubusercontent.com/TradeSkillMaster/wowlua-ls/main/editors/vscode/wowluarc.schema.json",

  "library": ["AeonUI/Libs/"],
  "ignore": ["Archive/"],
  "flavors": ["retail"],

  "globals": {
    "read": ["LibStub", "SlashCmdList", "StaticPopupDialogs", "UISpecialFrames", "WOW_PROJECT_CAMELOT", "ClickCastFrames"],
    "write": ["AeonUI*", "SLASH_AEONUI*", "SlashCmdList", "GetMinimapShape", "BINDING_HEADER_AEONUI", "BINDING_NAME_AEONUI_*", "ClickCastFrames"]
  },

  "diagnostics": {
    "enable": [
      "need-check-nil",
      "nil-index",
      "invalid-op",
      "redundant-condition",
      "redundant-and",
      "redundant-or",
      "unused-function",
      "unused-vararg"
    ]
  }
}
