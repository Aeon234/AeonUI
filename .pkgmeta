package-as: AeonUI

enable-nolib-creation: no

externals:
  AeonUI/Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  AeonUI/Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  AeonUI/Libs/LibSharedMedia-3.0: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  AeonUI/Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDataBroker-1.1
  AeonUI/Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  AeonUI/Libs/LibAeonSettings:
    url: https://github.com/Aeon234/LibAeonSettings.git
    tag: 1.5.0
  AeonUI/Libs/oUF:
    url: https://github.com/oUF-wow/oUF.git
    tag: 14.2.0
  AeonUI/Libs/LibSpecialization:
    url: https://github.com/BigWigsMods/LibSpecialization.git
    tag: v12.1.3

move-folders:
  AeonUI/AeonUI: AeonUI
  AeonUI/AeonUI_UnitFrames: AeonUI_UnitFrames
  AeonUI/AeonUI_Tooltip: AeonUI_Tooltip
  AeonUI/AeonUI_Maps: AeonUI_Maps
  AeonUI/AeonUI_QoL: AeonUI_QoL

ignore:
  - .pkgmeta
  - .wowluarc.json
  - .github
  - Tools
  - AeonUI/Dev
  - AeonUI_UnitFrames/Dev
  - AeonUI_Maps/Dev
  - AeonUI_QoL/Dev
  - "*.md"
  - Archive
